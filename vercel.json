{
  "rewrites": [
    {
      "source": "/api/auth/:action*",
      "destination": "/api/auth-handler"
    },
    {
      "source": "/api/orders/:action*",
      "destination": "/api/orders-handler"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
