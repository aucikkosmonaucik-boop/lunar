{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/products",
      "destination": "/api/products-handler"
    },
    {
      "source": "/api/categories",
      "destination": "/api/categories-handler"
    },
    {
      "source": "/api/promos",
      "destination": "/api/promos-handler"
    },
    {
      "source": "/api/reviews",
      "destination": "/api/reviews-handler"
    },
    {
      "source": "/api/reviews/:action",
      "destination": "/api/reviews-handler?action=:action"
    },
    {
      "source": "/api/loyalty",
      "destination": "/api/loyalty-handler"
    },
    {
      "source": "/api/loyalty/:action",
      "destination": "/api/loyalty-handler?action=:action"
    },
    {
      "source": "/api/auth/:action",
      "destination": "/api/auth-handler?action=:action"
    },
    {
      "source": "/api/orders/:action",
      "destination": "/api/orders-handler?action=:action"
    },
    {
      "source": "/api/stripe/:action",
      "destination": "/api/stripe-handler?action=:action"
    },
    {
      "source": "/api/debug",
      "destination": "/api/debug"
    },
    {
      "source": "/api/ping",
      "destination": "/api/ping"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
