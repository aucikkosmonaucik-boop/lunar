# Skopiuj ten plik jako `.env` w swoim lokalnym środowisku i uzupełnij prawdziwymi wartościami.
# NIE DODAJ PLIKU .env DO REPOZYTORIUM (jest już w .gitignore)!

# Adres URL do połączenia z Twoją bazą danych PostgreSQL na Railway
# Przykład: postgresql://postgres:TWOJE_HASLO@monorail.proxy.rlwy.net:12345/railway
DATABASE_URL="twoj_ul_do_bazy_z_railway"

# Losowy klucz służący do szyfrowania i podpisywania sesji logowania (JWT)
# Możesz użyć byle jakiego długiego i trudnego ciągu znaków.
JWT_SECRET="twoj_trudny_i_tajny_klucz_jwt"

# Klucze API do obsługi płatności Stripe (z https://dashboard.stripe.com/apikeys)
# Klucz prywatny (Secret Key) do tworzenia sesji Checkout:
STRIPE_SECRET_KEY="sk_test_..."
# Klucz publiczny (Publishable Key):
STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Adres URL Twojej aplikacji (dla przekierowań Stripe)
APP_URL="https://mylunar.shop"
